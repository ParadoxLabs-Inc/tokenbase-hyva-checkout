use Magento\Framework\Escaper;
use ParadoxLabs\TokenBase\Block\Customer\Cards;

/** @var Cards $block */
/** @var Escaper $escaper */
/** @var Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp */
?>
<div class="block-cards-list" x-data="tokenbaseCardsList">
    <h2 class="text-xl font-medium mb-4"><?= $escaper->escapeHtml($block->getPaymentMethodTitle()); ?></h2>

    <?php $cards = $block->getCards(); ?>
    <?php if (!empty($cards)): ?>
        <?php /** @var \ParadoxLabs\TokenBase\Model\Card $card */ ?>
        <?php foreach ($cards as $card): ?>
            <?php $card = $card->getTypeInstance(); ?>
            <?php $expired = $card->getExpires() !== '' && strtotime((string)$card->getExpires()) < time(); ?>
            <div class="border border-gray-300 rounded-md p-4 mb-4<?= $expired ? ' opacity-60' : '' ?>">
                <div class="flex items-center gap-2 mb-2">
                    <?php if (!empty($card->getType())): ?>
                        <img class="h-6"
                             src="<?= $escaper->escapeUrl($block->getViewFileUrl(
                                'Magento_Payment::images/cc/' . strtolower((string)$card->getType()) . '.png'
                             )); ?>"
                             alt="<?= $escaper->escapeHtmlAttr($block->getCcTypeLabel($card)); ?>"/>
                    <?php endif; ?>
                    <strong><?= $escaper->escapeHtml($card->getLabel(empty($card->getType()))); ?></strong>
                    <?php if ($expired): ?>
                        <span class="text-sm text-red-600"><?= $escaper->escapeHtml(__('(Expired)')) ?></span>
                    <?php elseif ($card->getExpires() !== ''): ?>
                        <span class="text-sm text-gray-500"><?= $escaper->escapeHtml(
                            __('(Expires %1)', date('m/Y', (int)strtotime((string)$card->getExpires())))
                        ); ?></span>
                    <?php endif; ?>
                </div>
                <address class="not-italic text-sm text-gray-700 mb-3">
                    <?= /* @noEscape */ $block->getFormattedCardAddress($card->getAddressObject()); ?>
                </address>
                <div class="flex gap-4 text-sm">
                    <?php if ($card->isInUse()): ?>
                        <abbr title="<?= $escaper->escapeHtmlAttr(
                            __('This payment record cannot be modified while associated with pending orders.')
                        ); ?>"><?= $escaper->escapeHtml(__('Card In Use')); ?></abbr>
                    <?php else: ?>
                        <a class="underline text-primary"
                           href="<?= $escaper->escapeUrl($block->getUrl('*/*', [
                               '_secure' => true,
                               'form_key' => $block->getFormKey(),
                               'method' => $card->getMethod(),
                               'id' => $card->getHash(),
                           ])) ?>"><?= $escaper->escapeHtml(__('Edit')) ?></a>
                        <button type="button"
                                class="underline text-primary"
                                @click="confirmDelete(
                                    '<?= $escaper->escapeJs($block->getUrl('*/*/delete', [
                                        '_secure' => true,
                                        'form_key' => $block->getFormKey(),
                                        'method' => $card->getMethod(),
                                        'id' => $card->getHash(),
                                    ])) ?>',
                                    '<?= $escaper->escapeJs($card->getLabel(empty($card->getType()))) ?>'
                                )"><?= $escaper->escapeHtml(__('Delete')) ?></button>
                    <?php endif; ?>
                </div>
            </div>
        <?php endforeach; ?>
    <?php else: ?>
        <p><?= $escaper->escapeHtml(__('You do not have any payment data saved yet.')) ?></p>
    <?php endif; ?>

    <!-- Delete confirmation modal -->
    <div x-show="deleteUrl !== null"
         x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center"
         role="dialog"
         aria-modal="true"
    >
        <div class="absolute inset-0 bg-black opacity-50" @click="deleteUrl = null"></div>
        <div class="relative bg-white rounded-md shadow-lg p-6 max-w-sm w-full mx-4">
            <p class="mb-4">
                <?= $escaper->escapeHtml(__('Are you sure you want to delete this payment record?')) ?>
                <strong x-text="deleteLabel"></strong>
            </p>
            <div class="flex justify-end gap-3">
                <button type="button" class="btn btn-secondary" @click="deleteUrl = null">
                    <?= $escaper->escapeHtml(__('Cancel')) ?>
                </button>
                <button type="button" class="btn btn-primary" @click="window.location.href = deleteUrl">
                    <?= $escaper->escapeHtml(__('Delete')) ?>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    'use strict';

    (function () {
        if (window.tokenbaseCardsListRegistered) {
            return;
        }

        window.tokenbaseCardsListRegistered = true;

        window.addEventListener('alpine:init', () => {
            Alpine.data('tokenbaseCardsList', () => ({
                deleteUrl: null,
                deleteLabel: '',
                confirmDelete(url, label) {
                    this.deleteUrl = url;
                    this.deleteLabel = label;
                },
            }));
        }, {once: true});
    })();
</script>
<?php if (isset($hyvaCsp)): ?>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
